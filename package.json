{
  "name": "dustfall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:intro": "tsc && vite build --mode intro",
    "preview:intro": "npm run build:intro && vite preview --mode intro",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit",
    "verify:all": "npm run verify && npm run verify:placement && npm run verify:colliders",
    "verify:placement": "node scripts/verify-placement.mjs",
    "verify:colliders": "node scripts/verify-colliders.mjs",
    "verify:intro": "node scripts/rig-shot.mjs --scenario=smoke-intro",
    "bench:intro": "node scripts/bench-intro.mjs",
    "rig-shot": "node scripts/rig-shot.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0"
  }
}
